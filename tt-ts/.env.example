# Supabase (PostgreSQL) — same DB as Python app
SUPABASE_HOST=your-pooler-host.supabase.com
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres.xxx
SUPABASE_PASSWORD=your-password
SUPABASE_PORT=5432

# Session (change in production)
SESSION_SECRET=your-session-secret

# Optional: seed first admin (when users table empty)
# SEED_MANAGER_USERNAME=admin
# SEED_MANAGER_PASSWORD=your-secret
