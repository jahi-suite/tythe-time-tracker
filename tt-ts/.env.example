# Supabase (PostgreSQL) — same DB as Python app
SUPABASE_HOST=your-pooler-host.supabase.com
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres.xxx
SUPABASE_PASSWORD=your-password
SUPABASE_PORT=5432
# Optional TLS certificate validation for DB SSL (default false for Supabase pooler compatibility)
# Set to true when using a trusted CA/certificate chain and direct Postgres host.
# DB_SSL_REJECT_UNAUTHORIZED=false

# Session (required in production; use a long random value)
SESSION_SECRET=your-session-secret
# Optional session store (defaults: dev=memory, prod=pg)
# SESSION_STORE=memory
# SESSION_STORE=pg
# SESSION_STORE=redis
# SESSION_PG_TABLE=user_sessions
# REDIS_URL=redis://localhost:6379
# REDIS_SESSION_PREFIX=tt:sess:

# Optional: seed first admin (when users table empty)
# SEED_MANAGER_USERNAME=admin
# SEED_MANAGER_PASSWORD=your-secret
# Optional: require this token for POST /api/auth/first-setup when users table is empty
# FIRST_SETUP_TOKEN=replace-with-random-setup-token

# Email — Gmail (personal) or Google Workspace
# Gmail: SMTP_HOST=smtp.gmail.com, use App Password for SMTP_PASS
# Workspace: SMTP_HOST=smtp-relay.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-16-chars
EMAIL_FROM="KariSuite <your-email@gmail.com>"
APP_BASE_URL=http://localhost:3000
