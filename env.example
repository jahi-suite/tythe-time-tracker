# Copy this file to .env and fill in your Supabase values.
# For local run: cp env.example .env
# For Streamlit Cloud: use the dashboard Secrets instead (see SUPABASE_SETUP.md)

SUPABASE_HOST=db.YOUR-PROJECT-REF.supabase.co
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-database-password
SUPABASE_PORT=5432
MANAGER_PASSWORD=your-manager-password
